# Dependencies and build output
node_modules/
dist/
client/dist/
client/dist-public/
client/dist-portal/
*.tsbuildinfo

# Local runtime state: uploaded files, coverage, caches
var/
coverage/
.vite/

# Secrets. The example file is committed; a real environment file never is.
.env
.env.*
!.env.example

# TLS material
deploy/tls/
*.pem
*.key
*.crt
*.p12
*.pfx

# Backups may contain the encryption key and the full customer database.
# Scoped deliberately: a blanket *.sql rule also swallows drizzle/migrations,
# which leaves a clone unable to build its own database. Migrations are source
# and must be tracked.
*.dump.sql
*.sql.gz
*.tar.gz
*.age
*.gpg
backups/

# Logs
*.log
logs/

# Editor and OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
