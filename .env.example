# ReadyPackets Portal — environment configuration
#
# Copy to .env and fill in real values. The server refuses to start in
# production if any required secret is missing, too short, or still holds a
# development placeholder.
#
# Generate each secret with:  openssl rand -hex 32

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=production

# Port the Node process listens on. nginx proxies to this.
PORT=3000

# Bind to loopback only when a reverse proxy sits in front, which it always
# should. Use 0.0.0.0 only inside a container network where the port is not
# published directly to the internet.
BIND_HOST=127.0.0.1

# Canonical portal/API URL. Must be https in production; used for session-facing
# links in outbound email, MFA, SAML, and the authenticated portal.
APP_URL=https://portal.readypackets.com

# Optional anonymous marketing-site URL. Set a distinct hostname (for example
# https://www.readypackets.com) to serve isolated public and portal bundles.
# Omit or set equal to APP_URL to retain the legacy one-host deployment.
PUBLIC_SITE_URL=https://www.readypackets.com

# Additional origins permitted to submit state-changing requests, comma
# separated. Include APP_URL and PUBLIC_SITE_URL for a dual-host deployment.
ALLOWED_ORIGINS=https://portal.readypackets.com,https://www.readypackets.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MySQL 8.0+ or MariaDB 10.11+.
DATABASE_URL=mysql://readypackets:CHANGE_THIS@127.0.0.1:3306/readypackets

# Per-instance pool size. In a horizontal deployment, the combined pool size of
# all web/worker replicas must remain below the database connection budget.
DATABASE_CONNECTION_LIMIT=16

# ---------------------------------------------------------------------------
# Secrets — all three are mandatory and must be unique to this deployment
# ---------------------------------------------------------------------------
# Signs session tokens. At least 48 characters.
SESSION_SECRET=

# AES-256-GCM key for encrypted columns. Exactly 64 hex characters.
# Losing this key makes every encrypted field unrecoverable. Back it up
# separately from the database, never in the same archive.
DATA_ENCRYPTION_KEY=

# HMAC key for the email blind index, enabling equality lookups on an
# encrypted column. Exactly 64 hex characters. Changing it requires
# rebuilding the index for every user.
EMAIL_INDEX_KEY=

# Optional public browser-title override. Defaults to ReadyPackets when unset.
SITE_NAME=ReadyPackets

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Number of proxy hops to trust when resolving the client address. Set to the
# actual number of proxies; an inflated value lets a client spoof its IP and
# defeat rate limiting.
TRUST_PROXY_HOPS=1

# Set to true only when traffic genuinely arrives through Cloudflare, so the
# CF-Connecting-IP header is honoured.
BEHIND_CLOUDFLARE=false

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Absolute session lifetime in minutes (720 = 12 hours).
SESSION_TTL_MINUTES=720

# Idle timeout in minutes. A session untouched for this long is invalidated
# even if the absolute lifetime has not elapsed.
SESSION_IDLE_TIMEOUT_MINUTES=120

# `all` preserves the single-node installer behaviour. For horizontal scaling,
# deploy web replicas with `web` and exactly one active worker with `worker`.
# Worker-capable instances own recurring queues; web-only instances do not.
INSTANCE_ROLE=all

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# "local" writes to the filesystem and is appropriate only for one portal node.
# For two or more web replicas, use "s3" with one private versioned bucket
# shared by every replica. S3_ENDPOINT is optional for AWS S3 and required for
# self-hosted/compatible providers such as MinIO.
STORAGE_DRIVER=local

# Directory for uploaded files. Must be outside the web root, which it is by
# default because nothing under var/ is ever served statically.
STORAGE_LOCAL_ROOT=/var/lib/readypackets/storage

# Maximum accepted upload size in bytes (52428800 = 50 MB).
MAX_UPLOAD_BYTES=52428800

# S3-compatible settings, used only when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Outbound email (SMTP)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to disable email entirely: messages are still queued
# and logged, so nothing is lost, but nothing is delivered either.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@readypackets.com
SMTP_REPLY_TO=info@readypackets.com

# ---------------------------------------------------------------------------
# Payments (optional)
# ---------------------------------------------------------------------------
# Leave empty to operate with manual invoicing, which is the default. When a
# key is present the checkout page is permitted to load Stripe's script, and
# only that page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SAML single sign-on (optional)
# ---------------------------------------------------------------------------
# Enterprise clients may authenticate through their own identity provider.
# Administrators still require a local password and a second factor.
SAML_ENABLED=false
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_IDP_CERT=

# ---------------------------------------------------------------------------
# Operational hardening
# ---------------------------------------------------------------------------
# Restrict the admin panel to these addresses or CIDR ranges, comma
# separated. Add your own network before enabling, or you will lock yourself
# out. Empty means no IP restriction.
ADMIN_IP_ALLOWLIST=

# Optional syslog target for shipping security events to a SIEM, in the form
# host:port. Empty keeps logs on the local filesystem only.
SYSLOG_TARGET=

# One of: debug, info, notice, warning, error, critical.
LOG_LEVEL=info

# Native mobile OAuth/OIDC. These must be verified HTTPS Universal/App Link callbacks that you control.
# Comma-separated; never use a custom scheme in production without a documented fallback threat review.
MOBILE_OAUTH_ISSUER=https://portal.example.com
MOBILE_OAUTH_REDIRECT_URIS=https://mobile.example.com/auth/callback
MOBILE_ACCESS_TOKEN_TTL_SECONDS=600
MOBILE_REFRESH_TOKEN_TTL_DAYS=30
